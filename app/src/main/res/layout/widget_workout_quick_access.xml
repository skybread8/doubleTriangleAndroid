<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#343430"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FDFDFD" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#E2E2E2" android:textSize="13sp" />
</LinearLayout>
